# ============================================================
# CoolFix WhatsApp AI Chatbot - Environment configuration
# Copy this file to ".env" and fill in the values you have.
# The app runs fully WITHOUT any of these (mock mode).
# ============================================================

# ---- AI provider ----
# Leave AI_PROVIDER=mock to run offline with the built-in rule-based engine.
# Set AI_PROVIDER=openai and paste your key below to use real OpenAI.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- WhatsApp provider ----
# "mock" = local simulator (no Meta account needed).
# "meta" = real Meta WhatsApp Cloud API (fill the values below).
WHATSAPP_PROVIDER=mock
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=coolfix-verify-token
META_APP_SECRET=

# ---- Security ----
# If set, dashboard + admin API calls must send this as: Authorization: Bearer <token>
# Leave empty to keep the local demo open (recommended for first run).
DASHBOARD_TOKEN=

# ---- Database ----
# Leave empty to use a local SQLite file (coolfix.db) for development.
# Set to a Postgres connection string in production so data is never lost.
# (Supabase: Settings -> Database -> Connection string -> Session pooler / URI)
DATABASE_URL=

# ---- Server ----
HOST=127.0.0.1
PORT=8000

# ---- Business ----
BUSINESS_ID=coolfix
